# Local development works without any external account or key.
# DATABASE_URL defaults to data/private/careerquest.db in local mode.
ENVIRONMENT=development
PUBLIC_API_ORIGIN=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
DEMO_MODE=true
AUTH_ENABLED=false
MENTOR_ENABLED=true
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
MAX_UPLOAD_BYTES=5242880
# Production: Supabase pooler URI with a restricted cq_api login, not postgres.
# DATABASE_URL=postgresql+psycopg://cq_api.PROJECT:PASSWORD@POOLER:6543/postgres?sslmode=require
# COOKIE_SECURE=true
# SHARE_TOKEN_PEPPER=generate-at-least-32-random-characters

